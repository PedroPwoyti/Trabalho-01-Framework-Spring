{
  "name": "trabalho-01-framework-spring",
  "version": "1.0.0",
  "description": "Testes automatizados das rotas REST da Editora API com Jest e Supertest",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --verbose --forceExit",
    "test:autores": "jest tests/autores.test.js --runInBand --verbose --forceExit",
    "test:artigos": "jest tests/artigos.test.js --runInBand --verbose --forceExit",
    "test:coverage": "jest --coverage --forceExit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroPwoyti/Trabalho-01-Framework-Spring.git"
  },
  "keywords": [
    "spring-boot",
    "jest",
    "supertest",
    "rest-api",
    "uepg"
  ],
  "author": "Luis Felipe da Rosa Teixeira, Otavio de Quadros Sonnenstrahl, Pedro Paulo Woytichoski Neto",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
